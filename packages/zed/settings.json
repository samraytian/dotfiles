// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "edit_predictions": {
    "mode": "eager",
    "provider": "ollama",
    "ollama": {
      "api_url": "http://localhost:11434",
      "model": "qwen2.5-coder:7b",
      "prompt_format": "qwen",
      "max_output_tokens": 64,
      "prediction_debounce": 250
    }
  },
  "diff_view_style": "unified",
  "icon_theme": {
    "mode": "light",
    "light": "Zed (Default)",
    "dark": "Zed (Default)"
  },
  "restore_on_startup": "launchpad",
  "project_panel": {
    "dock": "left"
  },
  "outline_panel": {
    "dock": "left"
  },
  "collaboration_panel": {
    "dock": "left"
  },
  "agent": {
    "sandbox_permissions": {
      "allow_unsandboxed": true,
      "allow_fs_write_all": true,
      "allow_all_hosts": true,
      "network_hosts": []
    },
    "tool_permissions": {
      "tools": {
        "move_path": {
          "default": "allow"
        },
        "fetch": {
          "default": "allow"
        },
        "terminal": {
          "default": "allow"
        }
      }
    },
    "default_model": {
      "provider": "openai-subscribed",
      "model": "gpt-6-astra",
      "enable_thinking": true,
      "effort": "medium"
    },
    "commit_message_model": {
      "provider": "openai-subscribed",
      "model": "gpt-5-luna",
      "enable_thinking": true,
      "effort": "low"
    },
    "dock": "right",
    "favorite_models": [],
    "model_parameters": []
  },
  "git_panel": {
    "dock": "left"
  },
  "proxy": "",
  "disable_ai": false,
  "which_key": {
    "enabled": true
  },
  "helix_mode": false,
  "vim_mode": true,
  "agent_servers": {
    "codex-acp": {
      "default_config_options": {
        "fast-mode": true
      },
      "type": "registry"
    },
    "claude-acp": {
      "type": "registry"
    }
  },
  "base_keymap": "VSCode",
  "ui_font_size": 16.0,
  "buffer_font_size": 14.0,
  "theme": {
    "mode": "system",
    "light": "One Light",
    "dark": "Ayu Darker"
  },
  "terminal": {
    "font_family": "Hack Nerd Font Mono",
    "font_size": 14.0
  },
}
