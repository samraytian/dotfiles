default_layout "compact"

plugins {
    compact-bar location="zellij:compact-bar" {
        tooltip "Alt /"
    }
}

theme "tokyo-night"

// Use the macOS clipboard explicitly instead of relying on terminal support.
copy_command "pbcopy"
copy_clipboard "system"

// Ctrl-s belongs to the editor (nvim :write) and to readline, so stop swallowing it
// and move Zellij's scroll mode to Alt-s. Scroll mode still exits with Esc / Ctrl c,
// and Ctrl-b [ (tmux mode) remains available as a second entry point.
//
// Ctrl-h belongs to the editor as well (nvim <C-h> switches to the window on the
// left). In current Zellij it only enters Move mode, while pane focus already lives
// on Alt-h/j/k/l and the Alt-arrow keys, so stop swallowing it and put Move mode on
// Alt-m instead.
//
// Zellij only reads the first top-level `unbind` node, so every unbound key has to
// live in this one node.
keybinds {
    unbind "Ctrl s" "Ctrl h"

    normal {
        bind "Alt s" { SwitchToMode "Scroll"; }
    }
    scroll {
        bind "Alt s" { SwitchToMode "Normal"; }
    }
    search {
        bind "Alt s" { SwitchToMode "Normal"; }
    }

    shared_except "move" "locked" {
        bind "Alt m" { SwitchToMode "Move"; }
    }
    move {
        bind "Alt m" { SwitchToMode "Normal"; }
    }
}

mouse_mode true
pane_frames true
scroll_buffer_size 10000
show_release_notes false
